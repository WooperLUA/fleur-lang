pub struct Vec2D
{
    x: Number,
    y: Number
}

Vec2D::new(x: Number, y: Number)
{
    return Vec2D { x : x, y : y };
}

Vec2D::normalize(): Vec2D
{
    const mag = this::magnitude();
    if mag == 0 { return Vec2D::new(0,0); }
    const inv_mag = 1.0 / mag;
    return Vec2D::new(this.x * inv_mag, this.y * inv_mag);
}

Vec2D::add(vec: Vec2D): Vec2D
{
    return Vec2D::new(this.x + vec.x, this.y + vec.y);
}

Vec2D::sub(vec: Vec2D): Vec2D
{
    return Vec2D::new(this.x - vec.x, this.y - vec.y);
}

Vec2D::scale(scalar: Number): Vec2D
{
    return Vec2D::new(this.x * scalar, this.y * scalar);
}

Vec2D::negate(): Vec2D
{
    return Vec2D::new(-this.x, -this.y);
}

Vec2D::cross(vec: Vec2D): Number
{
    return (this.x * vec.y) - (this.y * vec.x);
}

Vec2D::dot(vec: Vec2D): Number
{
    return (this.x * vec.x) + (this.y * vec.y);
}

Vec2D::rotate(radians: Number): Vec2D
{
    const cos_theta = math::cos(radians);
    const sin_theta = math::sin(radians);
    return Vec2D::new(
        this.x * cos_theta - this.y * sin_theta,
        this.x * sin_theta + this.y * cos_theta
    );
}

Vec2D::perpendicular(): Vec2D
{
    return Vec2D::new(-this.y, this.x);
}

Vec2D::angle(vec: Vec2D): Number
{
    const mag_product = this::magnitude() * vec::magnitude();
    if mag_product == 0 { return 0; }
    return math::acos(this::dot(vec) / mag_product);
}

Vec2D::magnitude(): Number
{
    return math::sqrt(this.x^2 + this.y^2);
}

Vec2D::distance_squared(vec: Vec2D): Number
{
    return (vec.x - this.x)^2 + (vec.y - this.y)^2;
}

Vec2D::distance(vec: Vec2D): Number
{
    return math::sqrt(this::distance_squared(vec));
}

Vec2D::string()
{
    return "(" + this.x + ", " + this.y + ")";
}