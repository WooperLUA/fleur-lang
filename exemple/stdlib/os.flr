// OS standard library example

// 1. Environment Variables
io::print("--- Environment Variables ---");

const user = os::env("USER"); // Works on Linux/macOS
const username = os::env("USERNAME"); // Works on Windows
var current_user = username;
if user != null{ current_user = user; }
io::print("Current user:", current_user);

// Set a new environment variable for this process
os::set_env("FLEUR_CUSTOM_VAR", "Hello from Fleur!");
io::print("Custom var:", os::env("FLEUR_CUSTOM_VAR"));


// 2. System Information
io::print("--- System Info ---");
io::print("Platform:", os.platform);      // e.g., "win32", "linux", "darwin"
io::print("Home Directory:", os.homedir);


// 4. Shell Execution
io::print("--- Shell Execution ---");

// Successful command execution
const echo_result = os::exec("echo 'Hello from the shell!'");
io::print("Echo result:", echo_result);

// Cross-platform directory listing
var list_cmd = "ls -1";
if os.platform == "win32" {
    list_cmd = "dir /b";
}
const files = os::exec(list_cmd);
io::print("Files in current directory : ");
io::print(files);


// 6. Process Control
io::print("--- Process Control ---");
io::print("Script finished successfully!");
os::exit(0);
