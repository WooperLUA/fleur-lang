// Reflect standard library example

// 1. "Object-like" structs: use ::new for behavior-rich structs
struct Person {
    name,
    age
}

Person::new(name, age) {
    return Person { name: name, age: age };
}

Person::hello() {
    return "Hello, my name is " + this.name;
}

const alice = Person::new("Alice", 30);
io::print("Person alice:", alice);
io::print("Alice says:", alice::hello());

// 2. Base Struct methods (available on ALL struct instances natively)
io::print("Has 'name'?", reflect::has(alice, "name"));
io::print("Has 'age'?", reflect::has(alice, "age"));
io::print("Has 'hello'?", reflect::has(alice, "hello"));
io::print("Has 'unknown'?", reflect::has(alice, "unknown"));

io::print("Struct name of alice:", reflect::identifier(alice));

// 3. "Map-like" data structs: use literal syntax
struct Point {
    x,
    y
}
const p = Point { x: 10, y: 20 };
io::print("Point p:", p);

io::print("Struct name of p:", reflect::identifier(p));
io::print("Has 'x'?", reflect::has(p, "x"));
io::print("Has 'z'?", reflect::has(p, "z"));

// 4. Dynamic Properties (Map-like behavior)
struct Config {
    theme
}
var my_config = Config { theme: "light" };

// Add a new property dynamically
reflect::set(my_config, "version", "1.0.0");
reflect::set(my_config, "debug", true);
my_config["dev_mode"] = false; // short hand syntax

io::print("Config after setting properties:", my_config);

// Verify they exist
io::print("Has 'version'?", reflect::has(my_config, "version"));


// Remove a property
const was_removed = reflect::remove(my_config, "debug");
io::print("Was 'debug' removed?", was_removed); // true
io::print("Config after removal:", my_config);

// Try removing a non-existent property
const was_removed_2 = reflect::remove(my_config, "non_existent");
io::print("Was 'non_existent' removed?", was_removed_2); // false


// 5. Reference equality
const obj_a = 1;
const obj_b = 1;
const obj_c = obj_a;
io::print("Is obj_a obj_b ? : ", reflect::is(obj_a, obj_b));
io::print("Is obj_c obj_a ? : ", reflect::is(obj_a, obj_c));