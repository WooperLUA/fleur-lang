// String standard library example

const text = "   Hello, Fleur Lang!   ";

// String length
io::print("Length of '", text, "' is", str::length(text));

// Trimming whitespace
const trimmed = str::trim(text);
io::print("Trimmed: '", trimmed, "'");

// Case conversion
io::print("Upper:", str::upper(trimmed));
io::print("Lower:", str::lower(trimmed));

// Substring check
if str::contains(trimmed, "Fleur") {
    io::print("The string contains 'Fleur'");
}

// Char at
io::print(str::at("fleur", 0));

// Slicing
const str_to_slice = "Hello, fleur!";
io::print("str::slice(str_to_slice, 1..3): ", str::slice(str_to_slice, 1..3));

io::print("str::slice(str_to_slice, 3..1): ", str::slice(str_to_slice, 3..1));

io::print("str::slice(str_to_slice, -3..-1): ", str::slice(str_to_slice, -3..-1));

io::print("str::slice(str_to_slice, 1..-3): ", str::slice(str_to_slice, 1..-3));