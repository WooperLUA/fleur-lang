// Range expressions example

// 1. Ranges as First-Class Values
io::print("--- First-Class Ranges ---");

// Store a range in a variable
const my_range = 1..5;
io::print("Stored range:", my_range); // Prints: 1..5

// Ranges can be passed to functions | procedures
proc print_range_info(r) {
    io::print(r);
}
print_range_info(my_range);


// 2. Range::new() Constructor
io::print("\n--- Range::new() ---");

// Create ranges programmatically with Range::new(start, end)
const dynamic_range = Range::new(1, 10);
io::print("Dynamic range:", dynamic_range); // Prints: 1..10

// Useful when bounds come from variables or calculations
const start = 5;
const end = start + 3;
const computed_range = Range::new(start, end);
io::print("Computed range:", computed_range); // Prints: 5..8

// Descending ranges work too
const countdown_range = Range::new(5, 1);
io::print("Countdown range:", countdown_range); // Prints: 5..1


// 3. Iterating Over Ranges
io::print("\n--- Range Iteration ---");

// Inline range (classic syntax)
io::print("Inline ascending:");
for i in 1..5 {
    io::print(" ", i);
}

// Iterating over a stored range
io::print("Stored range iteration:");
for i in my_range {
    io::print(" ", i);
}

// Iterating over a Range::new() range
io::print("Range::new iteration:");
for i in Range::new(3, 7) {
    io::print(" ", i);
}

// Descending iteration
io::print("Countdown:");
for i in countdown_range {
    io::print(" ", i);
}


// 4. Expanding Ranges into Arrays
io::print("\n--- Array Expansion ---");

// Expand an inline range
const arr1 = Array::from(1..5);
io::print("Array from 1..5:", arr1); // [1, 2, 3, 4, 5]

// Expand a stored range
const arr2 = Array::from(my_range);
io::print("Array from stored range:", arr2); // [1, 2, 3, 4, 5]

// Expand a Range::new() range
const arr3 = Array::from(Range::new(10, 15));
io::print("Array from Range::new:", arr3); // [10, 11, 12, 13, 14, 15]

// Descending expansion
const arr4 = Array::from(5..1);
io::print("Descending array:", arr4); // [5, 4, 3, 2, 1]

// Mix ranges with other values
const mixed = Array::new("start", 1..3, "end");
io::print("Mixed array:", mixed); // [start, 1..3, end]


// 5. Range containing values
io::print("\n--- Range containing values ---");
const r = 1..5;
io::print("Does 1..5 contains 2 :", r::contains(2));
io::print("Does 1..5 contains 6 :", r::contains(6));


// 6. Practical Use Case: Pagination
io::print("\n--- Practical: Pagination ---");

const total_items = 25;
const page_size = 10;
const current_page = 2;

const start_idx = (current_page - 1) * page_size + 1;
const end_idx = math::min(current_page * page_size, total_items);
const page_range = Range::new(start_idx, end_idx);

io::print("Page", current_page, "shows items:", page_range);

for item_num in page_range
{
    io::print("  Loading item #" + type::string(item_num) + "...");
}