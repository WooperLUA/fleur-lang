// Error struct + handling example

// 1. Custom User Errors
func safe_divide(a, b)
{
    if b == 0
    {
        Error::new("Division by zero is not allowed!")::throw();
    }
    return a / b;
}

io::print("--- Custom Errors ---");
try
{
    const result = safe_divide(10, 0);
    io::print("Result:", result); // This line will be skipped
}
catch err
{
    io::print("Caught a custom error:", err);
}


// 2. Catching Internal Runtime Errors
io::print("\n--- Internal Errors ---");

// Catching an OutOfBounds error from the interpreter
try
{
    const my_array = [1, 2, 3];
    io::print("Trying to access index 99...");
    const val = my_array[99]; // This triggers an internal OutOfBounds error
    io::print("Value:", val);
}
catch err
{
    io::print("Caught an internal error:", err);
}

// Catching a Type mismatch error
try
{
    io::print("Trying to add a number and a string...");
    const bad_math = 10 + "apples"; // Triggers a Runtime type error
}
catch err
{
    io::print("Caught a type error:", err);
}


// 3. Nested Try/Catch
io::print("\n--- Nested Try/Catch ---");
try
{
    io::print("Outer block starting...");

    try
    {
        Error::new("Inner error!")::throw();
    }
    catch inner_err
    {
        io::print("Caught inner error:", inner_err);
        io::print("Now throwing a new error from the catch block...");
        Error::new("Outer error!")::throw();
    }
}
catch outer_err
{
    io::print("Caught outer error:", outer_err);
}

io::print("\nScript finished successfully!");