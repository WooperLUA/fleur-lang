// Struct standard library example

// 1. "Object-like" structs: use ::new for behavior-rich structs
struct Person {
    name,
    age
}

Person::new(name, age) {
    return Person { name: name, age: age };
}

Person::hello() {
    return "Hello, my name is " + this.name;
}

const alice = Person::new("Alice", 30);
io::print("Person alice:", alice);
io::print("Alice says:", alice::hello());

// 2. Base Struct methods (available on ALL struct instances natively)
io::print("Has 'name'?", alice::has_property("name"));
io::print("Has 'age'?", alice::has_property("age"));
io::print("Has 'hello'?", alice::has_property("hello"));
io::print("Has 'unknown'?", alice::has_property("unknown"));

io::print("Struct name of alice:", alice::struct_name());

// 3. "Map-like" data structs: use literal syntax
struct Point {
    x,
    y
}
const p = Point { x: 10, y: 20 };
io::print("Point p:", p);

io::print("Struct name of p:", p::struct_name());
io::print("Has 'x'?", p::has_property("x"));
io::print("Has 'z'?", p::has_property("z"));

// 4. Computed Key Access (Map-like behavior)
// You can use variables to access struct properties dynamically
const dynamic_key = "x";
io::print("Accessing 'x' via variable:", p[dynamic_key]);