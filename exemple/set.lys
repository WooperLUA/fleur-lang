// Set standard library example

const s = set::new();

io::print("New set:", s);
io::print("Length:", set::length(s));

set::add(s, 1);
set::add(s, 2);
set::add(s, 1); // Duplicate

io::print("Set after adding 1, 2, 1:", s);
io::print("Length:", set::length(s));
io::print("Has 1:", set::has(s, 1));
io::print("Has 3:", set::has(s, 3));

set::remove(s, 1);
io::print("Set after removing 1:", s);
io::print("Has 1:", set::has(s, 1));
io::print("Length:", set::length(s));

// Test with complex types (structs)
struct Point { x, y }
const p1 = Point { x: 1, y: 2 };
const p2 = Point { x: 1, y: 2 };
const p3 = Point { x: 3, y: 4 };

const complex_set = set::new();
set::add(complex_set, p1);
set::add(complex_set, p2); // Should be considered duplicate
set::add(complex_set, p3);

io::print("Complex set (should have 2 points):", complex_set);
io::print("Length:", set::length(complex_set));
io::print("Has p2 (identical to p1):", set::has(complex_set, p2));

set::clear(s);
io::print("Set s after clear:", s);
io::print("Length s:", set::length(s));
