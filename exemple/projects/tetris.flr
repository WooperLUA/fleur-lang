const WIDTH = 10;
const HEIGHT = 20;

struct Piece
{
    x: Number,
    y: Number,
    grid: Array,
    char: String
}

// 7 Tetromino shapes represented as 4x4 string grids
const PIECES = [
    [ "....", "XXXX", "....", "...." ], // I
    [ "....", ".XX.", ".XX.", "...." ], // O
    [ "....", ".X..", "XXX.", "...." ], // T
    [ "....", ".XX.", "XX..", "...." ], // S
    [ "....", "XX..", ".XX.", "...." ], // Z
    [ "....", "X...", "XXX.", "...." ], // J
    [ "....", "..X.", "XXX.", "...." ]  // L
];

var SCORE = 0;

func replace_char(s, idx, c)
{
    var res = "";
    for i in 0..str::length(s) - 1
    {
        if i == idx
        {
            res += c;
        }
        else
        {
            res += str::at(s, i);
        }
    }
    return res;
}

func rotate_grid(grid)
{
    var new_grid = [];
    for x in 0..3
    {
        var row = "";
        for y in 0..3
        {
            // Clockwise rotation: new[x][y] = old[3-y][x]
            row += str::at(grid[3 - y], x);
        }
        new_grid::add(row);
    }
    return new_grid;
}

func create_board()
{
    return Array::from(1..HEIGHT)::fill("..........");
}

func spawn_piece()
{
    var idx = math::random(0..6);
    var grid = PIECES[idx];
    var c = "▢";

    var new_grid = [];
    for row in grid
    {
        var nr = "";
        for i in 0..3 {
            if str::at(row, i) == "X"
            {
                nr += c;
            }
            else
            {
                nr += ".";
            }
        }
        new_grid::add(nr);
    }
    return Piece { x: 3, y: 0, grid: new_grid, char: c };
}

func collides(board, piece)
{
    for py in 0..3
    {
        for px in 0..3
        {
            if str::at(piece.grid[py], px) != "."
            {
                var bx = piece.x + px;
                var by = piece.y + py;
                if bx < 0 or bx >= WIDTH or by >= HEIGHT
                {
                    return true;
                }
                if by >= 0
                {
                    if str::at(board[by], bx) != "."
                    {
                        return true;
                    }
                }
            }
        }
    }
    return false;
}

func merge_piece(board, piece)
{
    var new_board = [];
    for y in 0..(HEIGHT - 1)
    {
        var row = board[y];
        for py in 0..3 {
            for px in 0..3
            {
                if str::at(piece.grid[py], px) != "."
                 {
                    var bx = piece.x + px;
                    var by = piece.y + py;
                    if by == y and bx >= 0 and bx < WIDTH
                    {
                        row = replace_char(row, bx, piece.char);
                    }
                }
            }
        }
        new_board::add(row);
    }
    return new_board;
}

func clear_lines(board)
{
    var kept_rows = [];
    var cleared = 0;
    for y in 0..(HEIGHT - 1)
    {
        var full = true;
        for x in 0..(WIDTH - 1)
        {
            if str::at(board[y], x) == "." { full = false; }
        }
        if full
        {
            cleared += 1;
        }
        else
        {
            kept_rows::add(board[y]);
        }
    }
    var new_board = [];
    if cleared > 0
    {
        for i in 0..(cleared - 1)
        {
            new_board::add("..........");
        }
    }
    for row in kept_rows
    {
        new_board::add(row);
    }
    return [new_board, cleared];
}

proc render(board, piece)
{
    var display = [];
    for y in 0..(HEIGHT - 1)
    {
        var row = board[y];
        for py in 0..3
        {
            for px in 0..3
            {
                var c = str::at(piece.grid[py], px);
                if c != "."
                {
                    var bx = piece.x + px;
                    var by = piece.y + py;
                    if by == y and bx >= 0 and bx < WIDTH
                    {
                        row = replace_char(row, bx, c);
                    }
                }
            }
        }
        display::add("|" + row + "|");
    }

    io::clear();
    io::print("=== FLEUR TETRIS ===");
    io::print("Score: " + type::string(SCORE));
    io::print("==============");
    for row in display
    {
        io::print(row);
    }
    io::print("==============");
    io::print("Arrows/WASD: Move/Rotate | Enter/Down: Drop | Q: Quit");
}

var board = create_board();
var current = spawn_piece();
var game_over = false;

while not game_over
{
    render(board, current);

    var input = io::read_key();

    var next = current;
    var moved = false;
    var dropped = false;

    if input == "Q"
    {
        game_over = true;
    }
    else if input == "A" or input == "LEFT"
    {
        next = Piece { x: current.x - 1, y: current.y, grid: current.grid, char: current.char };
        moved = true;
    }
    else if input == "D" or input == "RIGHT"
    {
        next = Piece { x: current.x + 1, y: current.y, grid: current.grid, char: current.char };
        moved = true;
    }
    else if input == "W" or input == "UP"
    {
        next = Piece { x: current.x, y: current.y, grid: rotate_grid(current.grid), char: current.char };
        moved = true;
    }
    else if input == "S" or input == "DOWN" or input == "ENTER"
    {
        next = Piece { x: current.x, y: current.y + 1, grid: current.grid, char: current.char };
        dropped = true;
    }

    if not game_over
    {
        if not collides(board, next)
        {
            current = next;
        }
        else if dropped
        {
            board = merge_piece(board, current);
            const res = clear_lines(board);
            board = res[0];
            SCORE += res[1] * 100;

            current = spawn_piece();
            if collides(board, current)
            {
                game_over = true;
            }
        }
        // If horizontal/rotate move collided, we just ignore it (piece stays put)
    }
}

io::clear();
io::print("Game Over!");
io::print("Final Score: " + type::string(SCORE));