try
{
    const path = io.args[0];
    const prefix = io.args[1];
    const json_file = file::read(path);
    var parsed_json = json::parse(json_file);
    var new_json = Map::new();
    for kv in parsed_json::pairs()
    {
       new_json[prefix + kv[0]] = kv[1];
    }
    file::write(path, json::string(new_json));
}
catch err
{
    io::print(err);
    os::exit(1);
}