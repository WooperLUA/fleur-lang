// Unified `for ... in ...` loop examples

// 1. Iterating over a Range
io::print("--- Range Iteration ---");
for i in 1..5 {
    io::print("Range:", i);
}

io::print("\n--- Descending Range ---");
for i in 5..1 {
    io::print("Descending:", i);
}

// 2. Iterating over an Array
io::print("\n--- Array Iteration ---");
const fruits = ["apple", "banana", "cherry"];
for fruit in fruits {
    io::print("Fruit:", fruit);
}

// 3. Iterating over a Set
io::print("\n--- Set Iteration ---");
const unique_nums = Set::new(10, 20, 30, 20, 10); // Duplicates ignored
for num in unique_nums {
    io::print("Set element:", num);
}

// 4. Iterating over a Struct (yields [key, value] pairs)
io::print("\n--- Struct Iteration ---");
struct Config {
    host,
    port,
    debug
}
const my_config = Config { host: "localhost", port: 8080, debug: true };

for pair in my_config {
    const key = pair[0];
    const value = pair[1];
    io::print("Key:", key, "| Value:", value);
}
