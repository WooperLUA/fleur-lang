// Cast standard library example

// Get type of
io::print(type::of(1));
io::print(type::of("1"));
io::print(type::of(true));
io::print(type::of([1]));
io::print(type::of(Set::new(1)));
struct A {}
io::print(type::of(A {}));

// To Number
const n1 = type::number("123");
const n2 = type::number(true);
io::print("String to num:", n1);
io::print("Bool to num:", n2);

// To String
const s1 = type::string(456);
const s2 = type::string(false);
const s3 = type::string([1, 2, 3]);
io::print("Num to str:", s1);
io::print("Bool to str:", s2);
io::print("Array to str:", s3);

// To Boolean
const b1 = type::boolean(1);
const b2 = type::boolean(0);
const b3 = type::boolean("hello");
const b4 = type::boolean("");
io::print("1 to bool:", b1);
io::print("0 to bool:", b2);
io::print("'hello' to bool:", b3);
io::print("'' to bool:", b4);

// To Array
const arr1 = type::array(789);
const arr2 = type::array(false);
const arr3 = type::array("world");
const arr4 = type::array(Set::new(1,2,3,4,5));
io::print("Num to array:", arr1);
io::print("Bool to array:", arr2);
io::print("String to array:", arr3);
io::print("Set to array:", arr4);

// To Set
const set1 = type::set(789);
const set2 = type::set(false);
const set3 = type::set("world");
const set4 = type::set(Array::new(1,2,3,4,5,1));
io::print("Num to set:", set1);
io::print("Bool to set:", set2);
io::print("String to set:", set3);
io::print("Array to set:", set4);