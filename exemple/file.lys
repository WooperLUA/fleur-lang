// File standard library example

const test_file = "lys_test_output.txt";

// 1. Check if file exists (should be false initially)
io::print("File exists before creation?", file::exists(test_file));

// 2. Write to a new file
file::write(test_file, "Hello, Lys File System!\nLine 2.");
io::print("File written successfully.");

// 3. Check existence again (should be true)
io::print("File exists after creation?", file::exists(test_file));

// 4. Read the file back
const content = file::read(test_file);
io::print("--- File Content ---");
io::print(content);
io::print("--------------------");

// 5. Append to the file
file::append(test_file, "\nLine 3 (Appended!)");
io::print("Appended new line to file.");

// 6. Read again to verify append
const updated_content = file::read(test_file);
io::print("--- Updated Content ---");
io::print(updated_content);
io::print("-----------------------");

// 7. Remove the file
file::remove(test_file);
io::print("File removed.");

// 8. Verify deletion
io::print("File exists after deletion?", file::exists(test_file));
