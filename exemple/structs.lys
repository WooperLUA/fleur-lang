// Struct standard library example

// 1. "Object-like" structs: use ::new for behavior-rich structs
struct Person {
    name,
    age
}

// Convention: Use a static-like method 'new' for instantiation.
// This is especially useful for "object-like" structs that have associated behavior (methods).
// We use the capital Struct name (Person::new) to represent that it's "static-like".
// In Lys, there are no formal static methods; if you need a utility that doesn't 
// depend on an instance, you should usually just define a top-level function or proc.
Person::new(name, age) {
    return Person { name: name, age: age };
}

// Instance method: called on an instance (e.g., alice::hello())
Person::hello() {
    return "Hello, my name is " + this.name;
}

const alice = Person::new("Alice", 30); // Preferred way for behavior-heavy structs
io::print("Person alice:", alice);
io::print("Alice says:", alice::hello());

// Test structs::has
io::print("Has name:", structs::has(alice, "name"));
io::print("Has age:", structs::has(alice, "age"));
io::print("Has hello:", structs::has(alice, "hello"));

// Test structs::name
io::print("Struct name of alice:", structs::name(alice));

// 2. "Map-like" data structs: use literal syntax
// For simple data holding, explicit creation using the standard literal syntax
// is more fitting as it clearly shows the data structure.
struct Point {
    x,
    y
}

const p = Point { x: 10, y: 20 }; // Standard literal way for data containers
io::print("Point p:", p);
io::print("Struct name of p:", structs::name(p));

// Verify that it works with other structs-like things in stdlib if any
io::print("Struct name of structs module itself:", structs::name(structs));
io::print("Has 'has' in structs module:", structs::has(structs, "has"));
io::print("structs has name:", structs::has(structs, "name"));
