// IO standard library example

// printing to stdout
io::print("Hello", "World!");
io::print(1, true, [1, 2, 3]);

// printing to stderr
io::error("This is an error message");

// reading input from the user
const name = io::read_input("What is your name? ");
io::print("Hello, ", name);

// accessing command line arguments
// Note: io.args might be empty depending on how the script is run
io::print("Program's arguments : ", io.args);
