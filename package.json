{
  "name": "lys-lang",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "lys" : "bun run index.ts",
    "build-windows-x64": "bun build --compile --minify --sourcemap --bytecode --target=bun-windows-x64 --outfile=lys-runtime index.ts",
    "build-windows-arm64": "bun build --compile --minify --sourcemap --bytecode --target=bun-windows-arm64 --outfile=lys-runtime index.ts",
    "build-linux-x64": "bun build --compile --minify --sourcemap --bytecode --target=bun-linux-x64 --outfile=lys-runtime index.ts",
    "build-linux-arm64": "bun build --compile --minify --sourcemap --bytecode --target=bun-linux-arm64 --outfile=lys-runtime index.ts",
    "build-darwin-x64": "bun build --compile --minify --sourcemap --bytecode --target=bun-darwin-x64 --outfile=lys-runtime index.ts",
    "build-darwin-arm64": "bun build --compile --minify --sourcemap --bytecode --target=bun-darwin-arm64 --outfile=lys-runtime index.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
