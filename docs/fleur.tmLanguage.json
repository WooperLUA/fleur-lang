{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "fleur",
  "displayName": "Fleur",
  "scopeName": "source.flr",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.flr",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.flr",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.flr",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.flr",
          "match": "\\b(var|const|func|proc|struct|this|catch|else|for|if|import|in|pub|return|try|when|while)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.flr",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.flr",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.flr",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.operator.flr",
          "match": "(\\+|\\-|\\*|/|%|==|\\[|\\]|\\(|\\)|\\{|\\}|!=|<=|>=|<|>|=|\\+=|\\-=|\\*=|/=|::|\\.|\\.\\.|=>)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.flr",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    }
  }
}
