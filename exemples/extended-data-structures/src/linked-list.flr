struct LinkedListNode
{
    head,
    tail: LinkedListNode or Null
}

LinkedListNode::new(head, tail: LinkedListNode or Null = null)
{
    return LinkedListNode { head: head, tail: tail };
}

LinkedListNode::string()
{
    var s = type::string(this.head);
    if this.tail != null
        s += " -> ";
    return s;
}

func array_to_nodes(values: Array)
{
    if values::length() == 0
        return null;

    const value = values::shift();
    return LinkedListNode::new(value, array_to_nodes(values));
}

pub struct LinkedList
{
    base: LinkedListNode or Null
}
LinkedList::new(values: Array or Range)
{
    return LinkedList { base: array_to_nodes(Array::from(values)) };
}
LinkedList::add(value): LinkedList
{
    if this.base == null
    {
        this.base = LinkedListNode::new(value);
        return this;
    }

    var curr_node = this.base;

    while curr_node.tail != null
        curr_node = curr_node.tail;

    curr_node.tail = LinkedListNode::new(value);

    return this;
}
LinkedList::remove(index: Number): LinkedList
{
    if index == 0
    {
        if this.base != null
            this.base = this.base.tail;
        return this;
    }

    var curr_node = this.base;
    var current_index = 0;

    while curr_node != null and current_index < index - 1
    {
        curr_node = curr_node.tail;
        current_index += 1;
    }

    if curr_node != null and curr_node.tail != null
        curr_node.tail = curr_node.tail.tail;

    return this;
}
LinkedList::insert(index: Number, value)
{
    var curr_node = this.base;
    var current_index = 0;

    while curr_node != null
    {
        if current_index == index
        {
            const mem_node = reflect::clone(curr_node);
            curr_node.head = value;
            curr_node.tail = mem_node;
            return this;
        }

        curr_node = curr_node.tail;
        current_index += 1;
    }

    return null;
}
LinkedList::get(index: Number)
{
    var curr_node = this.base;
    var current_index = 0;

    while curr_node != null
    {
        if current_index == index
            return curr_node.head;

        curr_node = curr_node.tail;
        current_index += 1;
    }

    return null;
}
LinkedList::set(index: Number, value)
{
    var curr_node = this.base;
    var current_index = 0;

    while curr_node != null
    {
        if current_index == index
        {
            curr_node.head = value;
            return this;
        }

        curr_node = curr_node.tail;
        current_index += 1;
    }

    return null;
}
LinkedList::length(): Number
{
    var curr_node = this.base;
    var current_index = 0;

    while curr_node != null
    {
        curr_node = curr_node.tail;
        current_index += 1;
    }

    return current_index;
}
LinkedList::pop()
{
    var curr_node = this.base;
    var current_index = 0;

    while curr_node.tail != null
    {
        curr_node = curr_node.tail;
        current_index += 1;
    }

    const value = curr_node.head;
    this::remove(current_index);

    return value;
}
LinkedList::shift()
{
    const value = this.base.head;
    this.base = this.base.tail;
    return value;
}
LinkedList::contains(value): Boolean
{
    var curr_node = this.base;
    while curr_node.tail != null
    {
        if curr_node.head == value
            return true;
        curr_node = curr_node.tail;
    }

    return false;
}
LinkedList::last()
{
    var curr_node = this.base;

    while curr_node.tail != null
        curr_node = curr_node.tail;

    return curr_node.head;
}
LinkedList::first()
{
    return this.base.head;
}
LinkedList::reverse(): LinkedList
{
    var values = [];
    while not this::empty()
        values::add(this::pop());
    this.base = array_to_nodes(values);
    return this;
}
LinkedList::last(value, range)
{
    var curr_node = this.base;

    while curr_node.tail != null
        curr_node = curr_node.tail;

    return curr_node.head;
}
LinkedList::group(size)
{
    if size == 0 Error::new("'size' of ::group must be greater than 0.", "InvalidArgument")::throw();

    var values = [];
    var buffer = [];

    while not this::empty()
    {
        buffer::add(this::shift());

        if buffer::length() == size
        {
            values::add(array_to_nodes(buffer));
            buffer::clear();
        }
    }

    if not buffer::empty()
        values::add(array_to_nodes(buffer));

    this.base = array_to_nodes(values);
    return this;
}
LinkedList::empty(): Boolean
{
    return this::length() == 0;
}
LinkedList::string()
{
    var s = "(";
    var curr_node = this.base;
    var null_terminated = false;
    while not null_terminated
    {
        if curr_node == null
            null_terminated = true;
        else
        {
            s += curr_node::string();
            curr_node = curr_node.tail;
        }

    }
    return s + ")";
}

