pub struct FixedArray
{
    size: Number,
    arr: Array,
    initialized: Array
}
FixedArray::new(size: Number, values: Array = [])
{
    if size < 1
        Error::new("'size' of FixedArray::new must be greater than 0.", "InvalidArgument")::throw();

    if size < values::length()
        Error::new("length of 'values' cant be greater than 'size' of FixedArray::new", "InvalidArgument")::throw();

    var arr = Array::from(0..size)::fill(null);
    var initialized = Array::from(0..size)::fill(false);

    var i = 0;
    while i < values::length()
    {
        arr[i] = values[i];
        initialized[i] = true;
        i += 1;
    }

    return FixedArray {
        size: size,
        arr: arr,
        initialized: initialized
    };
}
FixedArray::get(index: Number)
{
    if index < 0 or index >= this.size
        Error::new("Index " + index + " is out of bounds for FixedArray of size " + this.size, "OutOfBounds")::throw();

    if not this.initialized[index]
        Error::new("Cannot read uninitialized index " + index + " of FixedArray", "UninitializedAccess")::throw();

    return this.arr[index];
}
FixedArray::set(index: Number, value)
{
    if index < 0 or index >= this.size
        Error::new("Index " + index + " is out of bounds for FixedArray of size " + this.size, "OutOfBounds")::throw();

    this.arr[index] = value;
    this.initialized[index] = true;
    return this;
}
FixedArray::size()
{
    return this.size;
}
FixedArray::contains(value)
{
    for i in 0..this.size - 1
    {
        if this.initialized[i] and this.arr[i] == value
            return true;
    }
    return false;
}
FixedArray::clear()
{
    this.arr::fill(null);
    this.initialized::fill(false);
    return this;
}
FixedArray::first()
{
    if this.initialized[0]
        return this.arr[0];
    return null;
}
FixedArray::last()
{
    const last_idx = this.size - 1;
    if this.initialized[last_idx]
        return this.arr[last_idx];
    return null;
}
FixedArray::reverse()
{
    this.arr::reverse();
    this.initialized::reverse();
    return this;
}
FixedArray::fill(value, range: Range or Null = null)
{
    var r = range;
    if r == null
        r = 0..this.size;
    this.arr::fill(value, r);
    this.initialized::fill(true, r);
    return this;
}
FixedArray::empty()
{
    return not this.initialized::contains(true);
}
FixedArray::string()
{
    var parts = [];
    for i in 0..this.size - 1
    {
        if this.initialized[i]
            parts::add(type::string(this.arr[i]));
        else
            parts::add("<uninitialized>");
    }
    return str::concat("<", this.size, "> ", parts);
}

