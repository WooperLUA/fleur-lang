import [CliCmd] in "cli-cmd.flr";

pub struct Cli
{
    args: Array,
    flags : Set,
    commands: Map
}

Cli::new(args: Array)
{
    if args::empty()
        Error::new("At least 1 argument is required.", "Cli::new")::throw();
    const flags = Set::new();
    for i in 0..args::length() - 1
    {
        const a = args[i];
        if str::prefixed(a, "-") or str::prefixed(a, "--")
        {
            flags::add(a);
            args::remove(i);
        }
    }
    return Cli {
        args: args,
        flags: flags,
        commands: {}
    };
}

Cli::add(cmd: CliCmd)
{
    this.commands[cmd.name] = cmd;
    return this;
}

Cli::help()
{
    io::print("Usage : ");
    for c in this.commands::values()
    {
        io::print(c::string());
    }
    os::exit(1);
}

Cli::run()
{
    const cmd_name = this.args::shift();
    if (not this.commands::has(cmd_name)) or cmd_name == "help"
        this::help();
    this.commands[cmd_name]::exec(this.args, this.flags);
}