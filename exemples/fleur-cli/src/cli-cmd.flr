pub struct CliCmd
{
    name: String,
    desc: String,
    usage: Map,
    exec: Function or Procedure
}

CliCmd::exec(args, flags)
{
    this.exec(args, flags);
}

CliCmd::string()
{
    const args = this.usage.args;
    const flags = this.usage.flags;
    return str::format("%\t%\t%\t%", this.name, args, flags, this.desc);
}